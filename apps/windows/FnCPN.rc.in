#define IDI_APP 1
IDI_APP ICON "@CMAKE_CURRENT_SOURCE_DIR@/../../assets/branding/AppIcon.ico"

1 VERSIONINFO
 FILEVERSION @FNCPN_VERSION_RESOURCE@,0
 PRODUCTVERSION @FNCPN_VERSION_RESOURCE@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "FnCPN\0"
      VALUE "FileDescription", "FnCPN Windows Client\0"
      VALUE "FileVersion", "@FNCPN_PRODUCT_VERSION@\0"
      VALUE "InternalName", "FnCPN\0"
      VALUE "OriginalFilename", "FnCPN.exe\0"
      VALUE "ProductName", "FnCPN\0"
      VALUE "ProductVersion", "@FNCPN_PRODUCT_VERSION@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
