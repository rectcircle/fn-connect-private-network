#!/bin/bash

set -eu
umask 077

BINARY="${TRIM_APPDEST}/server/fncpn"
RUN_DIR="${TRIM_PKGVAR}/run"
APP_RUN_DIR="${TRIM_APPDEST}/run"
APP_SOCKET="${APP_RUN_DIR}/app.sock"
PRIVILEGED_SOCKET="${RUN_DIR}/server-privileged.sock"
SERVER_PID_FILE="${RUN_DIR}/server.pid"
PRIVILEGED_PID_FILE="${RUN_DIR}/privileged.pid"
SERVER_LOG_DIR="${TRIM_PKGVAR}/logs/server"
PRIVILEGED_LOG_DIR="${TRIM_PKGVAR}/logs/privileged"
SERVER_LOG="${SERVER_LOG_DIR}/server.log"
PRIVILEGED_LOG="${PRIVILEGED_LOG_DIR}/privileged.log"
CONTROL_STATE="${TRIM_PKGETC}/control"
PRIVILEGED_STATE="${TRIM_PKGETC}/privileged"
APP_USER="fncpn"
UNIT_DIR="/etc/systemd/system"
SERVER_UNIT="fncpn-server.service"
PRIVILEGED_UNIT="fncpn-server-privileged.service"

log_error() {
    local message
    message="$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')"
    printf '{"time":"%s","level":"ERROR","msg":"%s"}\n' \
        "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$message" >&2
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
        printf '%s\n' "$1" > "$TRIM_TEMP_LOGFILE" || return 1
    fi
}

read_pid() {
    [ -r "$1" ] || return 1
    local pid
    pid="$(head -n 1 "$1" | tr -d '[:space:]')"
    case "$pid" in
        ''|*[!0-9]*|0|1) return 1 ;;
    esac
    printf '%s\n' "$pid"
}

process_matches() {
    local pid_file="$1"
    local expected_uid="$2"
    local expected_role="$3"
    local pid actual_uid executable command_line
    pid="$(read_pid "$pid_file")" || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    actual_uid="$(awk '/^Uid:/{print $2}' "/proc/${pid}/status" 2>/dev/null)" || return 1
    [ "$actual_uid" = "$expected_uid" ] || return 1
    executable="$(readlink -f "/proc/${pid}/exe" 2>/dev/null)" || return 1
    # An upgrade may have replaced the executable before the callback runs.
    executable="${executable% (deleted)}"
    [ "$executable" = "$(readlink -f "$BINARY")" ] || return 1
    command_line="$({ tr '\0' ' ' < "/proc/${pid}/cmdline"; } 2>/dev/null)" || return 1
    case "$command_line" in
        *"server ${expected_role}"*) return 0 ;;
        *) return 1 ;;
    esac
}

find_process() {
    local expected_uid="$1"
    local expected_role="$2"
    local status pid actual_uid executable command_line found=""
    for status in /proc/[0-9]*/status; do
        [ -r "$status" ] || continue
        pid="${status#/proc/}"
        pid="${pid%/status}"
        actual_uid="$(awk '/^Uid:/{print $2}' "$status" 2>/dev/null)" || continue
        [ "$actual_uid" = "$expected_uid" ] || continue
        executable="$(readlink -f "/proc/${pid}/exe" 2>/dev/null)" || continue
        executable="${executable% (deleted)}"
        [ "$executable" = "$(readlink -f "$BINARY")" ] || continue
        command_line="$({ tr '\0' ' ' < "/proc/${pid}/cmdline"; } 2>/dev/null)" || continue
        case "$command_line" in
            *"server ${expected_role}"*)
                [ -z "$found" ] || return 2
                found="$pid"
                ;;
        esac
    done
    [ -n "$found" ] || return 1
    printf '%s\n' "$found"
}

wait_for_health() {
    local role="$1"
    local socket="$2"
    local count=0
    HEALTH_ERROR=""
    while [ "$count" -lt 50 ]; do
        if HEALTH_ERROR="$("$BINARY" internal-healthcheck --role "$role" --socket "$socket" 2>&1)"; then
            return 0
        fi
        sleep 0.1
        count=$((count + 1))
    done
    return 1
}

initialize_log() {
    local path="$1" owner="$2"
    if [ -L "$path" ] || { [ -e "$path" ] && [ ! -f "$path" ]; }; then
        log_error "refusing unsafe application log path: $path"
        return 1
    fi
    # Install callbacks run as root; ordinary-user access may not yet be ready.
    # Append-open preserves existing logs and also creates a missing file.
    : >> "$path" || { log_error "application log could not be created: $path"; return 1; }
    chown "$owner" "$path" || { log_error "application log ownership could not be set: $path"; return 1; }
    chmod 0600 "$path" || { log_error "application log permissions could not be set: $path"; return 1; }
}

prepare_logs() {
    local directory path base index owner
    for directory in "${TRIM_PKGVAR}/logs" "$SERVER_LOG_DIR" "$PRIVILEGED_LOG_DIR"; do
        if [ -L "$directory" ] || { [ -e "$directory" ] && [ ! -d "$directory" ]; }; then
            log_error "refusing unsafe application log directory: $directory"
            return 1
        fi
        mkdir -p "$directory" || return 1
    done
    chown "root:$APP_USER" "$TRIM_PKGVAR" "${TRIM_PKGVAR}/logs" || return 1
    chmod 0750 "$TRIM_PKGVAR" "${TRIM_PKGVAR}/logs" || return 1
    chown "$APP_USER:$APP_USER" "$SERVER_LOG_DIR" || return 1
    chown root:root "$PRIVILEGED_LOG_DIR" || return 1
    chmod 0700 "$SERVER_LOG_DIR" "$PRIVILEGED_LOG_DIR" || return 1
    # Repair only the two daemons' known log families, retaining their contents.
    # Both ordinary logs and crash captures retain five numbered backups.
    for base in "$SERVER_LOG" "$PRIVILEGED_LOG"; do
        owner="root:root"
        [ "$base" != "$SERVER_LOG" ] || owner="$APP_USER:$APP_USER"
        for path in "$base" "$base.crash"; do
            initialize_log "$path" "$owner" || return 1
            for index in 1 2 3 4 5; do
                if [ -e "$path.$index" ] || [ -L "$path.$index" ]; then
                    initialize_log "$path.$index" "$owner" || return 1
                fi
            done
        done
    done
}

prepare_state() {
    local directory path owner
    for directory in "$CONTROL_STATE" "$PRIVILEGED_STATE"; do
        if [ -L "$directory" ] || { [ -e "$directory" ] && [ ! -d "$directory" ]; }; then
            log_error "refusing unsafe application state directory: $directory"
            return 1
        fi
        mkdir -p "$directory" || return 1
    done
    chown "root:$APP_USER" "$TRIM_PKGETC" || return 1
    chmod 0750 "$TRIM_PKGETC" || return 1
    chown "$APP_USER:$APP_USER" "$CONTROL_STATE" || return 1
    chown root:root "$PRIVILEGED_STATE" || return 1
    chmod 0700 "$CONTROL_STATE" "$PRIVILEGED_STATE" || return 1
    # Repair known persistent files without creating, rewriting or deleting them.
    # Ordinary control state must remain separate from root-only network secrets.
    for path in "$CONTROL_STATE/state.json" "$CONTROL_STATE/probe.key" \
        "$PRIVILEGED_STATE/server.key" "$PRIVILEGED_STATE/network-state.json"; do
        if [ -L "$path" ] || { [ -e "$path" ] && [ ! -f "$path" ]; }; then
            log_error "refusing unsafe application state file: $path"
            return 1
        fi
        [ -e "$path" ] || continue
        owner="root:root"
        case "$path" in "$CONTROL_STATE/"*) owner="$APP_USER:$APP_USER" ;; esac
        chown "$owner" "$path" || { log_error "application state ownership could not be set: $path"; return 1; }
        chmod 0600 "$path" || { log_error "application state permissions could not be set: $path"; return 1; }
    done
}

initialize_app() {
    if ! prepare_state; then
        log_error "application state permissions could not be prepared"
        return 1
    fi
    if ! prepare_logs; then
        log_error "application logs could not be prepared"
        return 1
    fi
    chown "root:$APP_USER" "$TRIM_PKGETC" "$TRIM_PKGVAR" "${TRIM_PKGVAR}/logs" || return 1
    chmod 0750 "$TRIM_PKGETC" "$TRIM_PKGVAR" "${TRIM_PKGVAR}/logs" || return 1
    chown root:root "$TRIM_APPDEST" "${TRIM_APPDEST}/server" "$BINARY" || return 1
    chmod 0755 "$TRIM_APPDEST" "${TRIM_APPDEST}/server" "$BINARY" || return 1
    chown "$APP_USER:$APP_USER" "$CONTROL_STATE" "$SERVER_LOG_DIR" || return 1
    chmod 0700 "$CONTROL_STATE" "$SERVER_LOG_DIR" || return 1
    chown root:root "$PRIVILEGED_STATE" "$PRIVILEGED_LOG_DIR" || return 1
    chmod 0700 "$PRIVILEGED_STATE" "$PRIVILEGED_LOG_DIR" || return 1
    if ! prepare_runtime; then
        log_error "application runtime directories could not be prepared"
        return 1
    fi
}

prepare_runtime() {
    mkdir -p "$RUN_DIR" "$APP_RUN_DIR" || return 1
    chown "root:$APP_USER" "$RUN_DIR" || return 1
    chmod 0750 "$RUN_DIR" || return 1
    chown "$APP_USER:$APP_USER" "$APP_RUN_DIR" || return 1
    chmod 0750 "$APP_RUN_DIR"
}

# Quote systemd command arguments and scalar paths, including specifier escaping.
# fnOS supplies absolute application paths. Newlines are not valid package paths.
unit_quote() {
    case "$1" in
        *$'\n'*|*$'\r'*) log_error "invalid newline in application path"; return 1 ;;
    esac
    local value="$1"
    value="${value//\\/\\\\}"
    value="${value//\"/\\\"}"
    value="${value//%/%%}"
    if [ "${2:-path}" = exec ]; then value="${value//\$/\$\$}"; fi
    printf '"%s"' "$value"
}

install_units() {
    local app_uid binary privileged_socket app_socket control privileged server_log privileged_log
    local run app_run server_logs privileged_logs
    app_uid="$(id -u "$APP_USER")" || return 1
    binary="$(unit_quote "$BINARY" exec)" || return 1
    privileged_socket="$(unit_quote "$PRIVILEGED_SOCKET" exec)" || return 1
    app_socket="$(unit_quote "$APP_SOCKET" exec)" || return 1
    control="$(unit_quote "$CONTROL_STATE" exec)" || return 1
    privileged="$(unit_quote "$PRIVILEGED_STATE" exec)" || return 1
    server_log="$(unit_quote "$SERVER_LOG" exec)" || return 1
    privileged_log="$(unit_quote "$PRIVILEGED_LOG" exec)" || return 1
    run="$(unit_quote "$RUN_DIR")" || return 1
    app_run="$(unit_quote "$APP_RUN_DIR")" || return 1
    server_logs="$(unit_quote "$SERVER_LOG_DIR")" || return 1
    privileged_logs="$(unit_quote "$PRIVILEGED_LOG_DIR")" || return 1
    mkdir -p "$UNIT_DIR" || return 1
    # Do not enable units: fnOS owns the application's startup intent.
    cat > "$UNIT_DIR/$PRIVILEGED_UNIT" <<EOF || return 1
[Unit]
Description=FnCPN restricted network service
Before=$SERVER_UNIT
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
Group=$APP_USER
ExecStart=$binary server privileged-daemon --socket $privileged_socket --state-dir $privileged --log-file $privileged_log --allow-uid $app_uid
Restart=on-failure
RestartSec=2
TimeoutStopSec=30
KillMode=control-group
UMask=0077
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictSUIDSGID=true
ReadWritePaths=$(unit_quote "$PRIVILEGED_STATE") $privileged_logs $run
EOF
    cat > "$UNIT_DIR/$SERVER_UNIT" <<EOF || return 1
[Unit]
Description=FnCPN application service
Wants=$PRIVILEGED_UNIT
After=$PRIVILEGED_UNIT
StartLimitIntervalSec=0

[Service]
Type=simple
User=$APP_USER
Group=$APP_USER
ExecStart=$binary server daemon --socket $app_socket --state-dir $control --privileged-socket $privileged_socket --log-file $server_log
Restart=on-failure
RestartSec=2
TimeoutStopSec=30
KillMode=control-group
UMask=0077
CapabilityBoundingSet=
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictSUIDSGID=true
ReadWritePaths=$(unit_quote "$CONTROL_STATE") $server_logs $app_run
EOF
    chmod 0644 "$UNIT_DIR/$PRIVILEGED_UNIT" "$UNIT_DIR/$SERVER_UNIT" || return 1
    systemctl daemon-reload
}

units_healthy() {
    systemctl is-active --quiet "$PRIVILEGED_UNIT" &&
        systemctl is-active --quiet "$SERVER_UNIT" &&
        wait_for_health server-privileged "$PRIVILEGED_SOCKET" &&
        wait_for_health server "$APP_SOCKET"
}

start_app() {
    if units_healthy; then
        return 0
    fi
    # Includes pre-1.1.4 PID-managed processes. Never prepare sockets/state
    # or start a second engine until both old processes have exited.
    stop_app || return 1
    initialize_app || return 1
    install_units || return 1
    if ! systemctl start "$PRIVILEGED_UNIT" ||
        ! wait_for_health server-privileged "$PRIVILEGED_SOCKET"; then
        log_error "privileged service failed its healthcheck: ${HEALTH_ERROR:-start failed}"
        stop_app || true
        return 1
    fi
    if ! su -s /bin/sh "$APP_USER" -c \
        "exec '$BINARY' internal-healthcheck --role server-privileged --socket '$PRIVILEGED_SOCKET'"; then
        log_error "application user cannot reach the privileged service"
        stop_app || true
        return 1
    fi
    if ! systemctl start "$SERVER_UNIT" || ! units_healthy; then
        log_error "application service failed its healthcheck: ${HEALTH_ERROR:-start failed}"
        stop_app || true
        return 1
    fi
}

stop_process() {
    local pid_file="$1"
    local expected_uid="$2"
    local expected_role="$3"
    local pid find_status count=0
    if process_matches "$pid_file" "$expected_uid" "$expected_role"; then
        pid="$(read_pid "$pid_file")"
    else
        rm -f "$pid_file"
        if pid="$(find_process "$expected_uid" "$expected_role")"; then
            printf '%s\n' "$pid" > "$pid_file"
        else
            find_status="$?"
            if [ "$find_status" -eq 1 ]; then
                return 0
            fi
            log_error "multiple ${expected_role} processes matched; refusing to stop"
            return 1
        fi
    fi
    kill -TERM "$pid" 2>/dev/null || true
    while process_matches "$pid_file" "$expected_uid" "$expected_role" &&
        [ "$count" -lt 10 ]; do
        sleep 1
        count=$((count + 1))
    done
    if process_matches "$pid_file" "$expected_uid" "$expected_role"; then
        kill -KILL "$pid" 2>/dev/null || true
        count=0
        while process_matches "$pid_file" "$expected_uid" "$expected_role" &&
            [ "$count" -lt 50 ]; do
            sleep 0.1
            count=$((count + 1))
        done
    fi
    if process_matches "$pid_file" "$expected_uid" "$expected_role"; then
        log_error "${expected_role} process did not stop"
        return 1
    fi
    rm -f "$pid_file"
}

stop_app() {
    local app_uid
    app_uid="$(id -u "$APP_USER")"
    # Stop supervised services first so Restart cannot race legacy cleanup.
    local unit
    for unit in "$SERVER_UNIT" "$PRIVILEGED_UNIT"; do
        if [ -f "$UNIT_DIR/$unit" ]; then
            systemctl stop "$unit" || return 1
        fi
    done
    stop_process "$SERVER_PID_FILE" "$app_uid" daemon || return 1
    stop_process "$PRIVILEGED_PID_FILE" 0 privileged-daemon || return 1
    if ! "$BINARY" internal-cleanup --role server --state-dir "$PRIVILEGED_STATE"; then
        log_error "server network cleanup failed; cleanup journal was retained"
        return 1
    fi
    rm -f "$APP_SOCKET" "$PRIVILEGED_SOCKET"
}

case "${1:-}" in
    initialize)
        if ! initialize_app; then
            log_error "FnCPN installation initialization failed"
            exit 1
        fi
        ;;
    start)
        start_app
        ;;
    stop)
        stop_app
        ;;
    status)
        if units_healthy; then exit 0; fi
        exit 3
        ;;
    uninstall)
        stop_app || exit 1
        for unit in "$SERVER_UNIT" "$PRIVILEGED_UNIT"; do
            if [ -f "$UNIT_DIR/$unit" ]; then
                systemctl disable "$unit" || exit 1
                rm -f "$UNIT_DIR/$unit"
            fi
        done
        systemctl daemon-reload
        ;;
    *)
        log_error "unsupported command: ${1:-<empty>}"
        exit 1
        ;;
esac
