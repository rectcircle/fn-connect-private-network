#!/bin/sh

set -eu

TOOL_DIR="/Library/PrivilegedHelperTools/cn.rectcircle.fncpn"
TOOL="${TOOL_DIR}/fncpn"
DAEMON_PLIST="/Library/LaunchDaemons/cn.rectcircle.fncpn.privileged.plist"
STATE_DIR="/var/db/fncpn"
PRIVILEGED_SOCKET="/var/run/fncpn-client-privileged.sock"

/bin/mkdir -p "$STATE_DIR" /var/log/fncpn
/usr/sbin/chown -R root:wheel \
  "$STATE_DIR" \
  /var/log/fncpn \
  "$TOOL_DIR" \
  /Applications/FnCPN.app \
  "$DAEMON_PLIST"
/bin/chmod 0700 "$STATE_DIR" /var/log/fncpn
/bin/chmod -R go-w "$TOOL_DIR" /Applications/FnCPN.app "$DAEMON_PLIST"
/bin/chmod 0755 "$TOOL_DIR" "$TOOL" "$TOOL_DIR/uninstall.sh"
/bin/chmod 0644 "$DAEMON_PLIST"
/usr/sbin/chown -h root:wheel /usr/local/bin/fncpn

/bin/launchctl bootout system/cn.rectcircle.fncpn.privileged 2>/dev/null || true
/bin/launchctl bootstrap system "$DAEMON_PLIST"
/bin/launchctl enable system/cn.rectcircle.fncpn.privileged
/bin/launchctl kickstart -k system/cn.rectcircle.fncpn.privileged

count=0
health_error=""
while [ "$count" -lt 50 ]; do
  if health_error="$("$TOOL" internal-healthcheck \
    --role client-privileged \
    --socket "$PRIVILEGED_SOCKET" 2>&1)"; then
    break
  fi
  /bin/sleep 0.1
  count=$((count + 1))
done
if [ "$count" -ge 50 ]; then
  printf 'FnCPN privileged healthcheck failed: %s\nLog: /var/log/fncpn/client-privileged.log\n' "$health_error" >&2
  exit 1
fi

exit 0
