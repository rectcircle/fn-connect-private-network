#!/bin/sh

set -eu

TOOL_DIR="/Library/PrivilegedHelperTools/com.rectcircle.fncpn"
TOOL="${TOOL_DIR}/fncpn"
DAEMON_PLIST="/Library/LaunchDaemons/com.rectcircle.fncpn.privileged.plist"
AGENT_PLIST="/Library/LaunchAgents/com.rectcircle.fncpn.client.plist"
STATE_DIR="/var/db/fncpn"
PRIVILEGED_SOCKET="/var/run/fncpn-client-privileged.sock"

/bin/mkdir -p "$STATE_DIR" /var/log/fncpn
/usr/sbin/chown -R root:wheel \
  "$STATE_DIR" \
  /var/log/fncpn \
  "$TOOL_DIR" \
  /Applications/FnCPN.app \
  "$DAEMON_PLIST" \
  "$AGENT_PLIST"
/bin/chmod 0700 "$STATE_DIR" /var/log/fncpn
/bin/chmod -R go-w "$TOOL_DIR" /Applications/FnCPN.app "$DAEMON_PLIST" "$AGENT_PLIST"
/bin/chmod 0755 "$TOOL_DIR" "$TOOL" "$TOOL_DIR/uninstall.sh"
/bin/chmod 0644 "$DAEMON_PLIST" "$AGENT_PLIST"
/usr/sbin/chown -h root:wheel /usr/local/bin/fncpn

/bin/launchctl bootout system/com.rectcircle.fncpn.privileged 2>/dev/null || true
/bin/launchctl bootstrap system "$DAEMON_PLIST"
/bin/launchctl enable system/com.rectcircle.fncpn.privileged
/bin/launchctl kickstart -k system/com.rectcircle.fncpn.privileged

count=0
health_error=""
while [ "$count" -lt 50 ]; do
  if health_error="$("$TOOL" internal-healthcheck \
    --role client-privileged \
    --socket "$PRIVILEGED_SOCKET" 2>&1)"; then
    break
  fi
  /bin/sleep 0.1
  count=$((count + 1))
done
if [ "$count" -ge 50 ]; then
  printf 'FnCPN privileged healthcheck failed: %s\nLog: /var/log/fncpn/client-privileged.log\n' "$health_error" >&2
  exit 1
fi

CONSOLE_UID="$(/usr/bin/stat -f '%u' /dev/console 2>/dev/null || true)"
if [ -n "$CONSOLE_UID" ] && [ "$CONSOLE_UID" -ge 500 ]; then
  /bin/launchctl bootout \
    "gui/${CONSOLE_UID}/com.rectcircle.fncpn.client" 2>/dev/null || true
  /bin/launchctl bootstrap "gui/${CONSOLE_UID}" "$AGENT_PLIST"
  /bin/launchctl enable "gui/${CONSOLE_UID}/com.rectcircle.fncpn.client"
  /bin/launchctl kickstart -k "gui/${CONSOLE_UID}/com.rectcircle.fncpn.client"

  HOME_DIR="$(/usr/bin/dscl . -read "/Users/$(/usr/bin/stat -f '%Su' /dev/console)" \
    NFSHomeDirectory | /usr/bin/awk '{print $2}')"
  CLIENT_SOCKET="${HOME_DIR}/Library/Application Support/FnCPN/run/client.sock"
  count=0
  health_error=""
  while [ "$count" -lt 50 ]; do
    if health_error="$(/bin/launchctl asuser "$CONSOLE_UID" "$TOOL" internal-healthcheck \
      --role client --socket "$CLIENT_SOCKET" 2>&1)"; then
      break
    fi
    /bin/sleep 0.1
    count=$((count + 1))
  done
  if [ "$count" -ge 50 ]; then
    printf 'FnCPN client healthcheck failed: %s\nLog: %s/Library/Logs/FnCPN/client.log\n' "$health_error" "$HOME_DIR" >&2
    exit 1
  fi
fi

exit 0
