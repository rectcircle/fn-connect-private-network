#!/bin/sh

set -eu

HELPER_ROOT="/Library/PrivilegedHelperTools"
TOOL="${HELPER_ROOT}/cn.rectcircle.fncpn/fncpn"
AGENT_LABEL="cn.rectcircle.fncpn.client"

# Protect the shared parent before the package writes any privileged executable.
if [ -L "$HELPER_ROOT" ]; then
  echo "FnCPN helper parent must not be a symbolic link: $HELPER_ROOT" >&2
  exit 1
fi
/bin/mkdir -p "$HELPER_ROOT"
/usr/sbin/chown root:wheel "$HELPER_ROOT"
/bin/chmod -N "$HELPER_ROOT"
/bin/chmod 0755 "$HELPER_ROOT"

# Stop the running UI before replacing its daemon and app bundle.
/bin/ps -axo uid=,pid=,command= | while read -r uid pid command; do
  case "$command" in
    "/Applications/FnCPN.app/Contents/MacOS/FnCPN"*) /bin/kill -TERM "$pid" 2>/dev/null || true ;;
  esac
done

if [ -x "$TOOL" ]; then
  /bin/ps -axo uid=,pid=,command= | while read -r uid pid command; do
    case "$command" in
      "$TOOL client daemon"*)
        /bin/launchctl bootout "gui/${uid}/${AGENT_LABEL}" 2>/dev/null || true
        /bin/kill -TERM "$pid" 2>/dev/null || true
        ;;
    esac
  done
fi

/bin/launchctl bootout system/cn.rectcircle.fncpn.privileged 2>/dev/null || true
count=0
while [ -f /var/db/fncpn/state.json ] && [ "$count" -lt 50 ]; do
  /bin/sleep 0.1
  count=$((count + 1))
done
if [ -f /var/db/fncpn/state.json ]; then
  echo "FnCPN network cleanup did not complete; refusing to replace the installation" >&2
  exit 1
fi

exit 0
