<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FnCPN</AssemblyName>
    <RootNamespace>FnCPN.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- This WPF host uses the application manifest as its process DPI contract; its generated WPF entry point does not call WinForms ApplicationConfiguration.Initialize. build-windows.ps1 validates the DPI settings embedded in each published EXE. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <ApplicationIcon>../../../packaging/assets/AppIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <Content Include="../../../packaging/assets/AppIcon.ico" Link="FnCPN.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../../packaging/assets/Status-connected.png;../../../packaging/assets/Status-offline.png;../../../packaging/assets/Status-working.png;../../../packaging/assets/Status-attention.png" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
