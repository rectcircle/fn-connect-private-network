<Window x:Class="FnCPN.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="FnCPN" FontSize="13" Width="560" Height="740" MinWidth="480" MinHeight="720"
        Background="#F3F5F7" WindowStartupLocation="CenterScreen" Closing="OnClosing">
  <Grid Margin="24">
    <TextBlock x:Name="LoadingText" Text="正在读取状态" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray"/>
    <Grid x:Name="LoginPanel" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="FnCPN" FontSize="26" FontWeight="SemiBold" />
          <TextBlock x:Name="AppVersionText" Margin="9,7,0,0" Foreground="Gray" FontSize="13" />
        </StackPanel>
        <TextBlock x:Name="LoginDescription" Margin="0,5,0,18" Foreground="Gray" Text="连接 fnOS 与已启用的家庭网络" />
      </StackPanel>
      <StackPanel Grid.Row="1" VerticalAlignment="Center">
        <TextBlock Text="FN Connect ID" Margin="4,5"/><TextBox x:Name="FnIdBox" AutomationProperties.Name="FN Connect ID"/>
        <TextBlock Text="fnOS 用户名" Margin="4,5"/><TextBox x:Name="UsernameBox" AutomationProperties.Name="fnOS 用户名"/>
        <TextBlock Text="fnOS 密码" Margin="4,5"/><PasswordBox x:Name="PasswordBox" Padding="8,6" Margin="4,3" AutomationProperties.Name="fnOS 密码"/>
        <TextBlock x:Name="LoginError" Foreground="Firebrick" TextWrapping="Wrap" Margin="4,10" AutomationProperties.LiveSetting="Assertive"/>
      </StackPanel>
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="退出" Click="OnExit" AutomationProperties.HelpText="停止连接并退出" />
        <Button x:Name="ReturnDetailsButton" Content="返回连接详情" Click="OnReturnDetails" Visibility="Collapsed"/>
        <Button x:Name="CancelLoginButton" Content="取消" Click="OnCancelLogin" Visibility="Collapsed"/>
        <Button x:Name="LoginButton" Content="登录并连接" IsDefault="True" Click="OnLogin"/>
      </StackPanel>
    </Grid>
    <Grid x:Name="DetailsPanel" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,20"><Image x:Name="HeaderIcon" Width="36" Height="36" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="FnCPN" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="DetailsVersionText" Foreground="Gray" Margin="10,9,0,0"/></StackPanel>
        <TextBlock x:Name="IdentityText" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
        <TextBlock x:Name="StateText" FontSize="23" FontWeight="SemiBold" Text="正在读取状态" Margin="0,0,0,14" AutomationProperties.LiveSetting="Polite"/>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="4,0,4,12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid.Resources><Style TargetType="TextBlock"><Setter Property="Margin" Value="0,4"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style></Grid.Resources>
          <TextBlock Foreground="Gray" Text="连接路径"/><TextBlock x:Name="PathText" Grid.Column="2"/>
          <TextBlock Foreground="Gray" Text="隧道地址" Grid.Row="1"/><TextBlock x:Name="AddressText" Grid.Row="1" Grid.Column="2"/>
          <TextBlock Foreground="Gray" Text="网络接口" Grid.Row="2"/><TextBlock x:Name="NetworkText" Grid.Row="2" Grid.Column="2"/>
          <TextBlock Foreground="Gray" Text="最近握手" Grid.Row="3"/><TextBlock x:Name="HandshakeText" Grid.Row="3" Grid.Column="2"/>
          <TextBlock Foreground="Gray" Text="特权服务" Grid.Row="4"/><TextBlock x:Name="PrivilegeText" Grid.Row="4" Grid.Column="2"/>
          <TextBlock Foreground="Gray" Text="IPv6 检测" Grid.Row="5"/><TextBlock x:Name="DirectText" Grid.Row="5" Grid.Column="2"/>
          <TextBlock Foreground="Gray" Text="NAS IP" Grid.Row="6"/><StackPanel Grid.Row="6" Grid.Column="2" Orientation="Horizontal"><TextBlock x:Name="NasText"/><Button Content="&#xE8A7;" FontFamily="Segoe MDL2 Assets" Click="OnOpenNas" ToolTip="打开 NAS" AutomationProperties.Name="打开 NAS" Style="{StaticResource IconButtonStyle}"/></StackPanel>
        </Grid>
        <WrapPanel Grid.Row="1" Margin="0,0,0,16"><Button x:Name="PrimaryButton" Content="连接" Tag="&#xE945;" Click="OnPrimary"/><Button x:Name="ReloginButton" Content="重新登录" Tag="&#xE77B;" Click="OnRelogin"/><Button x:Name="RetryButton" Content="重试" Tag="&#xE777;" Click="OnRetry"/></WrapPanel>
        <TextBlock Grid.Row="2" Text="诊断详情" Foreground="Gray" Margin="4,0,4,6"/>
        <Border Grid.Row="3" Background="White" BorderBrush="#D3D7DC" BorderThickness="1" Margin="4,0,4,10" MinHeight="50" MaxHeight="110"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8">
          <StackPanel>
            <StackPanel.Resources><Style TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0"/><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></StackPanel.Resources>
            <TextBlock x:Name="StatusError" Foreground="Firebrick" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
            <TextBlock x:Name="DiagnosticErrorsText" TextWrapping="Wrap"/>
            <TextBlock x:Name="LanOverlapText" Foreground="DarkOrange" TextWrapping="Wrap"/>
            <TextBlock x:Name="ProbeDetailsText" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
          </StackPanel>
        </ScrollViewer></Border>
        <TextBlock x:Name="DiagnosticsText" Visibility="Collapsed"/>
      </Grid>
      <StackPanel Grid.Row="2">
        <WrapPanel><Button x:Name="ChangeServerButton" Content="切换服务器" Tag="&#xE8AB;" Click="OnChangeServer"/><Button x:Name="AdminButton" Content="管理后台" Tag="&#xE774;" Click="OnOpenAdmin" Visibility="Collapsed"/>
          <Button Content="&#xE8C8;" FontFamily="Segoe MDL2 Assets" ToolTip="复制诊断" AutomationProperties.Name="复制诊断" Click="OnCopyDiagnostics" Style="{StaticResource IconButtonStyle}"/>
          <Button Content="&#xE8B7;" FontFamily="Segoe MDL2 Assets" ToolTip="打开日志" AutomationProperties.Name="打开日志" Click="OnOpenLog" Style="{StaticResource IconButtonStyle}"/>
          <Button Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" ToolTip="刷新状态" AutomationProperties.Name="刷新状态" Click="OnRefresh" Style="{StaticResource IconButtonStyle}"/>
          <Button Content="退出" Tag="&#xE7E8;" Click="OnExit"/></WrapPanel>
        <Button x:Name="RepairServiceButton" Content="修复网络服务（需要管理员权限）" HorizontalAlignment="Center" Click="OnRepairService" Visibility="Collapsed"/>
        <CheckBox x:Name="AutoStartBox" AutomationProperties.AutomationId="AutoStartBox" Content="登录 Windows 后启动 FnCPN" Margin="8" Checked="OnAutoStartChanged" Unchecked="OnAutoStartChanged"/>

      </StackPanel>
    </Grid>
  </Grid>
</Window>
